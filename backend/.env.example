DATABASE_URL="postgresql://user:password@localhost:5432/gymrecover?schema=public"

NODE_ENV="development"

# --- Auth0 ---
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_AUDIENCE="https://api.gymrecover.dev"
# DEV ONLY. Must be unset/false in any real environment (see src/auth/jwt-auth.guard.ts).
AUTH_DEV_BYPASS="false"

# --- App-level field encryption (32-byte key, base64-encoded; use a real KMS in production) ---
FIELD_ENCRYPTION_KEY=""

# --- S3-compatible media storage ---
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
